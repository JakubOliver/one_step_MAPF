# Doxygen configuration for the C++ API consumed by Sphinx/Breathe.

PROJECT_NAME           = "one_step_MAPF"
PROJECT_BRIEF          = "One-step multi-agent path finding solver"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO

INPUT                  = ../src
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES
EXCLUDE                = ../src/Main.cpp
EXCLUDE_PATTERNS       = */external/*

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
SEARCH_INCLUDES        = YES
QUIET                  = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = YES
GENERATE_TREEVIEW      = YES
